{
  "name": "amrutam-telemedicine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "\u003e=24 \u003c25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "worker": "tsx src/worker-main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "check": "tsc --noEmit \u0026\u0026 node --check public/app.js",
    "schema": "tsx scripts/schema.ts",
    "demo": "tsx scripts/demo.ts",
    "format": "prettier --write src scripts tests public vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check src scripts tests public vitest.config.ts playwright.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
