              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start=Date.now()+86400000;pm.variables.set('slotStart',new Date(start).toISOString());pm.variables.set('slotEnd',new Date(start+1800000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201)pm.environment.set('slotId',pm.response.json().id);"
                ]
              }
            }
