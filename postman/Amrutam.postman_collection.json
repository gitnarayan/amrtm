    {
      "name": "02 - Authentication and manual MFA",
      "item": [
        {
          "name": "POST /v1/auth/register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "Register patient and obtain MFA enrollment token\nSee README for the correct account/token. Do not run all requests unattended: MFA is manual and logout revokes sessions.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": {{passwordJson}},\n  \"name\": \"Synthetic Test User\",\n  \"consentVersion\": \"2026-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const password=pm.environment.get('password');if(!password)throw new Error('Set password locally before sending');pm.variables.set('passwordJson',JSON.stringify(password));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
                  "pm.test('Authentication token returned',()=>pm.expect(pm.response.json().token).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/auth/login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "Validate password and obtain MFA challenge\nSee README for the correct account/token. Do not run all requests unattended: MFA is manual and logout revokes sessions.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": {{passwordJson}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const password=pm.environment.get('password');if(!password)throw new Error('Set password locally before sending');pm.variables.set('passwordJson',JSON.stringify(password));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Authentication token returned',()=>pm.expect(pm.response.json().token).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/auth/mfa/enroll",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/auth/mfa/enroll",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{challengeToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "Create TOTP secret; limited to initial enrollment\nSee README for the correct account/token. Do not run all requests unattended: MFA is manual and logout revokes sessions.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/auth/mfa/verify",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/auth/mfa/verify",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{challengeToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "Verify one-time TOTP and issue 15 minute access token\nSee README for the correct account/token. Do not run all requests unattended: MFA is manual and logout revokes sessions.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Access granted after MFA',()=>pm.expect(pm.response.json().kind).to.equal('access'));"
                ]
              }
            }
          ]
        }
      ]
    },
