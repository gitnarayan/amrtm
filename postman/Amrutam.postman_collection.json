    {
      "name": "10 - Logout (last)",
      "item": [
        {
          "name": "POST /v1/auth/logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/auth/logout",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patientToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "Revoke all current sessions\nSee README for the correct account/token. Do not run all requests unattended: MFA is manual and logout revokes sessions.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
