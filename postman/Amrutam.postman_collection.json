    {
      "name": "07 - Audit and analytics",
      "item": [
        {
          "name": "GET /v1/admin/analytics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/admin/analytics?from={{fromDate}}&to={{toDate}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "description": "Read asynchronous daily aggregates with freshness timestamp\nSee README for the correct account/token. Do not run all requests unattended: MFA is manual and logout revokes sessions."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.environment.get('fromDate'))pm.variables.set('fromDate',new Date().toISOString().slice(0,10));if(!pm.environment.get('toDate'))pm.variables.set('toDate',new Date().toISOString().slice(0,10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/admin/audit",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/admin/audit",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "description": "Read bounded audit metadata (no clinical payload)\nSee README for the correct account/token. Do not run all requests unattended: MFA is manual and logout revokes sessions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
