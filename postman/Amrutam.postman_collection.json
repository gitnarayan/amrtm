{
  "info": {
    "name": "Amrutam - All APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All 22 OpenAPI operations plus transition variants and negative checks. Manual MFA required. Read README. No credentials included. Tokens are entered manually in local environment values; do not share populated exports."
  },
